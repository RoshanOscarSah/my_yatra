rules_version = '2';

// MyYatra Firestore rules.
// Private by default (NFR / US-1.5): a traveller can only read and write their
// own documents under users/{uid}. Admins manage the shared district data but
// can never read another user's personal data (US-15.3, NFR-14).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hasVisited(districtId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/visits/$(districtId));
    }

    // ---------- Personal data ----------
    match /users/{uid} {
      // A new user document must start as a traveller.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'traveller';
      // Users may update their own profile but may never change their role.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow read, delete: if signedIn() && request.auth.uid == uid;

      // Sub-collections only (visits, journal, ...). A bare {document=**}
      // would also match users/{uid} itself in rules v2 and let a user
      // bypass the role check above and make themselves admin.
      match /{collection}/{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- Shared district data ----------
    match /districts/{districtId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /places/{placeId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    // Collection-group reads of places (admin analytics).
    match /{path=**}/places/{placeId} {
      allow read: if signedIn();
    }

    // ---------- Reviews (US-13.1, US-15.7) ----------
    match /reviews/{reviewId} {
      allow read: if signedIn();
      // Only travellers who marked the district visited may review it, as themselves.
      // Edits are checked the same way, so a rating cannot be changed to 999
      // or moved to a district the user has not visited.
      function validReview() {
        return request.resource.data.uid == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && hasVisited(request.resource.data.districtId);
      }
      allow create: if signedIn() && validReview();
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && validReview()
        && request.resource.data.districtId == resource.data.districtId;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- Safety alerts (US-12.1, US-15.6) ----------
    match /alerts/{alertId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Feedback & reports (US-14.x, US-15.5) ----------
    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new';
      // The sender can follow the status of their own reports.
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // Admins change the status. When a user deletes their account, the
      // sender may only blank out the uid on their own reports, so the report
      // stays for the team but is no longer linked to them.
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.uid == ''
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']));
      allow delete: if isAdmin();
    }

    // ---------- Admin change log (US-15.4) ----------
    match /changeLog/{entryId} {
      allow read, write: if isAdmin();
    }

    // ---------- Aggregate visit totals only (US-15.3, NFR-14) ----------
    // One document per district: {visits: n}. No user id is stored. A
    // traveller can only move a total by one, and only in the same batch
    // that creates (+1) or deletes (-1) their own visit to that district,
    // so totals cannot be inflated by hand.
    match /districtStats/{districtId} {
      function myVisit() {
        return /databases/$(database)/documents/users/$(request.auth.uid)/visits/$(districtId);
      }
      function addsVisit() {
        return !exists(myVisit()) && existsAfter(myVisit());
      }
      function removesVisit() {
        return exists(myVisit()) && !existsAfter(myVisit());
      }
      function onlyVisits() {
        return request.resource.data.keys().hasOnly(['visits'])
          && request.resource.data.visits is int;
      }
      allow read: if isAdmin();
      allow create: if signedIn() && onlyVisits()
        && request.resource.data.visits == 1 && addsVisit();
      allow update: if signedIn() && onlyVisits() && (
        (request.resource.data.visits == resource.data.visits + 1 && addsVisit())
        || (request.resource.data.visits == resource.data.visits - 1 && removesVisit()));
    }
  }
}
