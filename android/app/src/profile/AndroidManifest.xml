<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The local Firebase emulators speak plain HTTP (10.0.2.2 on the Android
         emulator, or your Mac's IP on a real phone). Android blocks plain HTTP
         by default, so allow it in debug and profile builds only. Release
         builds keep the default and only use HTTPS. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"/>
</manifest>
